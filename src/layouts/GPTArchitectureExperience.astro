---
import Base from './Base.astro';
import GPTExplorer from '../components/gpt-architecture/GPTExplorer.jsx';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  lede?: string;
  date: Date;
  minutes?: number;
  ogImage?: string;
}

const { title, description, lede, date, minutes, ogImage } = Astro.props;
const formatted = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date);
---

<Base title={title} description={description} wide ogImage={ogImage} forceLight>
  <article class="gpt-experience-article">
    <header class="gpt-experience-header">
      <p class="gpt-experience-kicker">Interactive · modern decoder</p>
      <h1>{title}</h1>
      <p class="gpt-experience-lede">{lede}</p>
      <p class="gpt-experience-meta">{formatted}{minutes ? ` · ${minutes} min read + lab` : ''}</p>
    </header>

    <div class="gpt-explorer-breakout">
      <GPTExplorer client:only="react">
        <div class="gpt-explorer-fallback" slot="fallback" aria-label="Loading the interactive GPT explorer">
          <span aria-hidden="true">▥</span>
          <strong>Loading the trained nano GPT…</strong>
          <small>4 layers · 8-wide residual stream · 1,800 training steps</small>
        </div>
      </GPTExplorer>
      <noscript>
        <p class="gpt-explorer-noscript">
          This explainer needs JavaScript for the interactive 3D view. The article below
          still covers the same architecture in text.
        </p>
      </noscript>
    </div>

    <div class="prose gpt-experience-copy">
      <slot />
    </div>
  </article>
</Base>

<style>
  .gpt-experience-article {
    padding-top: 0.25rem;
    font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
  }

  .gpt-experience-header {
    max-width: 55rem;
    margin: 0 auto 2.75rem;
    text-align: center;
  }

  .gpt-experience-kicker {
    margin-bottom: 1rem;
    color: #526072;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .gpt-experience-header h1 {
    max-width: 54rem;
    margin: 0 auto 1rem;
    font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(3rem, 6.7vw, 5.5rem);
    font-weight: 620;
    line-height: 0.96;
    letter-spacing: -0.065em;
  }

  .gpt-experience-lede {
    max-width: 48rem;
    margin: 1rem auto 1.1rem;
    color: #526072;
    font-size: clamp(1.1rem, 2.3vw, 1.35rem);
    line-height: 1.58;
  }

  .gpt-experience-meta {
    color: #718095;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 0.78rem;
  }

  .gpt-explorer-breakout {
    width: min(97vw, 100rem);
    margin: 0 50% 4.25rem;
    transform: translateX(-50%);
  }

  .gpt-explorer-noscript {
    max-width: 42rem;
    margin: 1rem auto;
    color: var(--muted);
  }

  .gpt-explorer-fallback {
    display: grid;
    height: 760px;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    color: #172033;
    border: 1px solid #e1e5ea;
    border-radius: 24px;
    background: #f8f7f2;
    box-shadow: 0 24px 64px rgba(42, 54, 71, 0.09);
    font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    text-align: center;
  }

  .gpt-explorer-fallback span {
    color: #2563eb;
    font-size: 2.3rem;
  }

  .gpt-explorer-fallback strong {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .gpt-explorer-fallback small {
    color: #718095;
    font-family: 'Geist Mono Variable', ui-monospace, monospace;
    font-size: 0.78rem;
  }

  .gpt-experience-copy {
    max-width: 42rem;
    margin: 0 auto;
    color: #30394a;
    font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.06rem;
    line-height: 1.78;
  }

  .gpt-experience-copy :global(h2),
  .gpt-experience-copy :global(h3) {
    color: #172033;
    font-family: 'Geist Variable', ui-sans-serif, system-ui, sans-serif;
    font-weight: 620;
    letter-spacing: -0.03em;
  }

  .gpt-experience-copy :global(h2) {
    margin-top: 3.5rem;
    font-size: 1.65rem;
  }

  .gpt-experience-copy :global(a) {
    text-decoration-color: #9bb7e8;
    text-underline-offset: 3px;
  }

  @media (max-width: 1080px) {
    .gpt-explorer-fallback {
      height: 690px;
    }
  }

  @media (max-width: 560px) {
    .gpt-experience-header {
      text-align: left;
    }

    .gpt-experience-header h1 {
      margin-left: 0;
    }

    .gpt-experience-lede {
      margin-left: 0;
    }

    .gpt-explorer-breakout {
      width: calc(100vw - 1rem);
    }

    .gpt-explorer-fallback {
      height: 1850px;
      border-radius: 16px;
    }
  }
</style>
